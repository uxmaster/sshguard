#!/bin/sh
set -e

is_runit() {
    [ -r /proc/1/comm ] && [ "$(cat /proc/1/comm)" = runit ]
}

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        if is_runit; then
            # When migrating an older SysV-managed installation to runit,
            # stop its PID-file process before registering the native service.
            if [ -n "${2:-}" ] && [ -s /run/sshguard.pid ]; then
                start-stop-daemon --stop --quiet --oknodo --retry 30 \
                    --pidfile /run/sshguard.pid
            fi
            install -d -m 0750 -o _runit-log -g adm \
                /var/log/runit/sshguard
            if [ ! -e /etc/service/sshguard ] && \
                    [ ! -e /etc/service/.sshguard ]; then
                /usr/sbin/update-service --add /etc/sv/sshguard >/dev/null
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
