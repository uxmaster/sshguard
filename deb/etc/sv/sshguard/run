#!/usr/bin/env /lib/runit/invoke-run
set -e

exec 2>&1
for firewall in /usr/sbin/iptables /usr/sbin/ip6tables; do
    "$firewall" -w -N sshguard >/dev/null 2>&1 || true
    "$firewall" -w -C INPUT -j sshguard >/dev/null 2>&1 ||
        "$firewall" -w -I INPUT -j sshguard
done
# SSHGuard's EXIT trap runs "kill 0"; isolate it from runsv and svlogd.
# https://smarden.org/runit/chpst.8
exec chpst -P /usr/sbin/sshguard
